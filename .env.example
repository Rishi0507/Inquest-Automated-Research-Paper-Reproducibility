# Copy to .env and fill in what applies. Every variable is optional except where noted.

# Language model for claim extraction, the Cartographer and patch proposals.
# Required for registering unseen papers; the curated corpus runs without it.
ANTHROPIC_API_KEY=
INQUEST_LLM_MODEL=claude-opus-5

# Optional local fallback: an Ollama server and model name.
INQUEST_LOCAL_LLM_URL=
INQUEST_LOCAL_LLM_MODEL=

# Sandbox backend: "local" (resource-capped subprocess) or "docker" (network-isolated container).
INQUEST_SANDBOX=local

# Concurrency and caps. Keep workers x threads at or below the number of CPU cores.
INQUEST_WORKERS=2
INQUEST_THREADS_PER_RUN=1
INQUEST_RUN_TIMEOUT=420
INQUEST_RUN_MEMORY_MB=4096

# Location of runs, environments, caches and the database (defaults to ./.inquest).
INQUEST_WORKSPACE=
